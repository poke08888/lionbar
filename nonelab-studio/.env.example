# Nonelab Studio — environment configuration
# Copy to ".env" and fill in your key.

# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: model override. Must support video understanding.
# Good options: gemini-2.5-flash (default, fast/cheap), gemini-2.5-pro (deeper).
GEMINI_MODEL=gemini-2.5-flash

# Optional: port for the server (default 3000)
PORT=3000

# Optional: override the API base (rarely needed)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
